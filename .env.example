# Generate private credentials with: python tools/manage.py init --url https://YOUR-SERVER
CODY_API_TOKEN=
CODY_TRANSLATOR_TOKEN=
CODY_SPEECH_TOKEN=
CODY_PORT=9131
PUBLIC_URL=https://YOUR-SERVER

# Base mode needs no AI account. Sources start empty; discovery starts disabled.
AI_ENABLED=false
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_ALLOW_HTTP=false
AI_TOKEN_LIMIT_FIELD=max_tokens

# Optional transcription; disabled | compatible | local
SPEECH_PROVIDER=disabled
SPEECH_BASE_URL=
SPEECH_MODEL=
SPEECH_API_KEY=
SPEECH_ALLOW_HTTP=false
# Local whisper.cpp installation, if selected:
# SPEECH_LOCAL_BIN=/data/tiktok-language/whisper-cli
# SPEECH_LOCAL_MODEL=/data/tiktok-language/ggml-tiny-q5_1.bin

# Set ai and/or speech after configuring the corresponding providers.
COMPOSE_PROFILES=
